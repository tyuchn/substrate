apiVersion: batch/v1
kind: Job
metadata:
  name: ${JOB}
  namespace: imgbench
  labels:
    app: imgbench-loader
    arm: ${ARM}
spec:
  backoffLimit: 0
  ttlSecondsAfterFinished: 7200
  template:
    metadata:
      labels:
        app: imgbench-loader
        arm: ${ARM}
    spec:
      restartPolicy: Never
      serviceAccountName: loader
      nodeSelector:
        bench-role: driver
      tolerations:
      - key: bench-role
        operator: Equal
        value: driver
        effect: NoSchedule
      containers:
      - name: loader
        image: ko://go.ate.dev/substrate/benchmarking/image-plugin/loader
        args: [${MODE}, -arm, ${ARM}, -atespace, ${ATESPACE}, -workload, bench-oci-uvm,
          -snapshot-location, "${SNAPSHOT_LOCATION}",
          -cpu-millicores, "1000", -memory-bytes, "1073741824",
          -reads, "1000", -writes, "2", -think-min, "5s", -think-max, "8s",
          -out, /results/out.jsonl, -linger, 30m ${EXTRA_ARGS}]
        resources:
          requests:
            cpu: "2"
            memory: 2Gi
        volumeMounts:
        - name: config
          mountPath: /config
        - name: results
          mountPath: /results
      volumes:
      - name: config
        configMap:
          name: imgbench-images
      - name: results
        emptyDir: {}
